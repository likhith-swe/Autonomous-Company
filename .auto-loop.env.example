# ============================================================
# Autonomous Company — Environment Configuration Template
# Copy this file to .auto-loop.env and add your active keys.
# ============================================================

# Choose Engine: "claude" or "openai-compatible" or "codex"
ENGINE=claude

# === If using Claude Code (Default) ===
# ANTHROPIC_API_KEY=sk-ant-api03-...
CLAUDE_PERMISSION_MODE=bypassPermissions

# === If using OpenAI-Compatible Endpoints (DeepSeek, OpenRouter, Groq, Ollama) ===
# OPENAI_COMPATIBLE_ADAPTER_ENABLED=1
# OPENAI_COMPATIBLE_ENDPOINT=https://api.deepseek.com/chat/completions
# OPENAI_COMPATIBLE_MODEL=deepseek-chat
# OPENAI_COMPATIBLE_API_KEY=sk-...
# OPENAI_COMPATIBLE_ALLOW_SHELL=1

# === Loop Configuration ===
LOOP_INTERVAL=30
CYCLE_TIMEOUT_SECONDS=1800
MAX_CONSECUTIVE_ERRORS=5
AUTONOMOUS_COMPANY_LANGUAGE=en
